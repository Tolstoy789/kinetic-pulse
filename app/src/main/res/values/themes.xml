<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema de ventana: negro AMOLED desde el primer frame para evitar flash blanco. -->
    <style name="Theme.KineticPulse" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/kinetic_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- SplashScreen API nativa (minSdk 31): la línea de pulso se dibuja al abrir la app. -->
        <item name="android:windowSplashScreenBackground">@color/kinetic_black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_pulse_animated</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
    </style>
</resources>
